# =============================================================================
# Acolher — variáveis de ambiente
# Copie para .env.local (nunca versione .env.local).
# Variáveis NEXT_PUBLIC_* vão para o navegador: NUNCA coloque segredos nelas.
# =============================================================================

# --- Site ---------------------------------------------------------------------
# URL pública (usada em links de e-mail: convites, recuperação de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase -----------------------------------------------------------------
# Local: valores impressos por `npx supabase start` (ou `npx supabase status`).
# Nuvem: Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Chave publicável (ou "anon" em projetos antigos). Segura no navegador: só funciona dentro do RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave SECRETA (ou "service_role" em projetos antigos). Somente servidor. Ignora RLS.
SUPABASE_SECRET_KEY=

# --- Inteligência artificial --------------------------------------------------
# anthropic | openai | mock
# "mock" é um simulador SEM IA (respostas fixas), sinalizado na interface. Use só em dev/testes.
AI_PROVIDER=mock

# Anthropic (SDK oficial @anthropic-ai/sdk)
ANTHROPIC_API_KEY=
# Padrão: claude-opus-5-5
ANTHROPIC_MODEL=claude-opus-5-5
# Profundidade de raciocínio: low | medium | high | xhigh | max (padrão: medium)
ANTHROPIC_EFFORT=medium

# OpenAI (SDK oficial openai) — o modelo é obrigatório quando AI_PROVIDER=openai
# A API é cobrada à parte do ChatGPT: é preciso ter créditos em platform.openai.com/settings/organization/billing
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Para modelos de raciocínio (gpt-5.x): none | minimal | low | medium | high. Vazio = não enviar.
# "low" dá respostas mais rápidas, adequado a conversa.
OPENAI_REASONING_EFFORT=low

# Tempo máximo para a IA responder (ms). Mínimo 5000.
AI_TIMEOUT_MS=45000

# --- Segurança da equipe ----------------------------------------------------------
# true = o painel exige verificação em duas etapas (TOTP) para todos da equipe.
STAFF_REQUIRE_MFA=false

# --- Testes E2E -----------------------------------------------------------------
# 1 = roda também o fluxo de chat (exige Supabase local com migrações aplicadas).
E2E_SUPABASE=0
